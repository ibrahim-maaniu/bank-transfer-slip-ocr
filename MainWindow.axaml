<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TransactionOCR.MainWindow"
        Title="Transaction OCR"
        Width="900"
        Height="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorder" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SubtleText" Color="#888888"/>
        <SolidColorBrush x:Key="SlightBackground" Color="#f5f5f3"/>
        <SolidColorBrush x:Key="FoundGreen" Color="#0F6E56"/>
    </Window.Resources>

    <DockPanel Background="#F5F5F3">

        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Transaction OCR"
                           FontWeight="Medium"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="Black"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Left Panel -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <TextBlock Text="IMAGE INPUT"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource SubtleText}"
                                   LetterSpacing="1"/>
                    </Border>
                    <Border Grid.Row="1"
                            Margin="14"
                            BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="24"
                            Name="DropZone">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="⬆"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource SubtleText}"/>
                            <TextBlock Text="Drag &amp; drop image here"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="PNG, JPG, BMP supported"
                                       FontSize="12"
                                       Foreground="{StaticResource SubtleText}"
                                       HorizontalAlignment="Center"/>
                            <Button Name="BrowseButton"
                                    Cursor="Hand"
                                    Content="Browse file"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0"
                                    Foreground="Black"
                                    BorderBrush="{StaticResource PanelBorder}"
                                    Click="BrowseButton_Click">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="TextBlock.Foreground" Value="Black"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"></Setter>
                                    </Style>
                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2"
                            Margin="14,0,14,14"
                            Background="#F5F5F3"
                            BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Panel>
                            <StackPanel Name="ImagePlaceholder"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                <TextBlock Text="🖼"
                                           FontSize="32"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Image preview"
                                           FontSize="12"
                                           Foreground="{StaticResource SubtleText}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Image Name="PreviewImage"
                                   Stretch="Uniform"
                                   IsVisible="False"/>
                            <Button Name="ClearButton"
                                    Content="X"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,6,6,0"
                                    Padding="6,2"
                                    FontSize="12"
                                    IsVisible="False"
                                    Foreground="Black"
                                    Cursor="Hand"
                                    Click="ClearButton_Click"/>
                        </Panel>
                    </Border>
                </Grid>
            </Border>
            <!-- Right Panel -->
            <Border Grid.Column="1" Background="White">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <TextBlock Text="OCR OUTPUT"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource SubtleText}"
                                   LetterSpacing="1"/>
                    </Border>
                    <TextBox Grid.Row="1"
                             Name="OcrOutputBox"
                             Margin="14"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Courier New"
                             FontSize="12"
                             Background="#D1D1D1"
                             PlaceholderText="OCR text will appear here after processing..."/>
                    <Border Grid.Row="2"
                            Margin="14,0,14,10"
                            Background="#F5F5F3"
                            BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Amount found"
                                           FontSize="12"
                                           Foreground="{StaticResource SubtleText}"/>
                                <TextBlock Name="AmountResult"
                                           Text="—"
                                           FontSize="20"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource SubtleText}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Name="CopyAmountButton"
                                    Content="Copy"
                                    VerticalAlignment="Center"
                                    Foreground="black"
                                    Cursor="Hand"
                                    Click="CopyAmount"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3"
                            Margin="14,0,14,10"
                            Background="{StaticResource SlightBackground}"
                            BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Transaction ID"
                                           FontSize="12"
                                           Foreground="{StaticResource SubtleText}"/>
                                <TextBlock Name="TransactionID"
                                           Text="—"
                                           FontSize="20"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource SubtleText}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Name="CopyTransactionIdButton"
                                    Content="Copy"
                                    VerticalAlignment="Center"
                                    Foreground="black"
                                    Cursor="Hand"
                                    Click="CopyTransactionID"></Button>
                        </Grid>
                    </Border>
                    <Border Grid.Row="4"
                            Margin="14,0,14,10"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Background="{StaticResource SlightBackground}"
                            BorderBrush="{StaticResource PanelBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Transaction Date"
                                           FontSize="12"
                                           Foreground="{StaticResource SubtleText}"/>
                                <TextBlock Name="TransactionDate"
                                           Text="—"
                                           FontSize="20"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource SubtleText}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Name="CopyTransactionDateButton"
                                    Content="Copy"
                                    VerticalAlignment="Center"
                                    Foreground="Black"
                                    Cursor="Hand"
                                    Click="CopyTransactionDate"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>